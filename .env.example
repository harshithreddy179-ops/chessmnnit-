# ============================================================================
# MNNIT Chess Community — environment variables
#
# Copy to .env.local for local development (never commit the copy), and set the same
# names in your hosting provider (Vercel → Project → Settings → Environment Variables).
# The app starts without any of them and shows honest "awaiting configuration" states;
# each feature switches on when its variables are present. See docs/DEPLOYMENT.md.
#
# Names starting NEXT_PUBLIC_ are sent to the browser. Everything else stays on the server.
# ============================================================================

# --- Site ---------------------------------------------------------------------
# Public origin of the site, no trailing slash. Used for OAuth redirects, canonical URLs and
# the Chess.com User-Agent. Production: https://chess.example.edu   Local: http://localhost:3000
# On Vercel it falls back to VERCEL_PROJECT_PRODUCTION_URL when unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (REQUIRED for sign-in and every database-backed page) -----------
# Project Settings → API. Local Supabase CLI default: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=
# The publishable key (sb_publishable_…). Safe for browsers; protected by RLS.
# (The legacy name NEXT_PUBLIC_SUPABASE_ANON_KEY is also accepted.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The SECRET key (sb_secret_…). SERVER ONLY. Bypasses RLS. Needed for: scheduled jobs, linking a
# verified Chess.com account, suspending users at the Auth layer, account deletion, and
# `npm run admin:bootstrap`. Never expose it, never prefix it NEXT_PUBLIC_.
# (The legacy name SUPABASE_SERVICE_ROLE_KEY is also accepted.)
SUPABASE_SECRET_KEY=

# --- Scheduled jobs ------------------------------------------------------------
# Shared secret for /api/cron/*. At least 24 characters, random:  openssl rand -hex 32
# Callers send   Authorization: Bearer <CRON_SECRET>   (Vercel Cron does this automatically).
# Unset or too short → the endpoints stay closed (503).
CRON_SECRET=

# --- Chess.com Published-Data API ----------------------------------------------
# Public data needs no key. Chess.com asks API users to identify themselves; this address is
# put in the User-Agent so they can contact you instead of blocking you. Use a monitored inbox.
CHESSCOM_CONTACT_EMAIL=
# Politeness / reliability knobs (defaults shown). Requests are always strictly serial.
# CHESSCOM_MIN_REQUEST_INTERVAL_MS=400
# CHESSCOM_REQUEST_TIMEOUT_MS=10000
# CHESSCOM_MAX_RETRIES=3

# --- Optional -------------------------------------------------------------------
# Seconds the public landing/leaderboard data may be served from cache (default 60).
# PUBLIC_DATA_REVALIDATE_SECONDS=60

# --- Local development / tooling only (not used by the running app) --------------
# Plain PostgreSQL for `npm run db:local` and `npm run db:types`.
# LOCAL_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/mnnit_dev
# Admin connection for `npm run test:db` (needs permission to create databases and roles).
# TEST_DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
# Point Playwright at a specific Chromium instead of the bundled one.
# PLAYWRIGHT_CHROMIUM_PATH=

# --- Test / staging stand-ins (leave unset in production) -----------------------
# Redirects the Chess.com client to another host. Used by the browser tests (a local fake).
# CHESSCOM_API_BASE_URL=
